{
  "name": "reality_signal_slate",
  "description": "Reality Signal slate polish: center layouts, per-line background variety (intro escalating intrigue), per-type signatures/sizes, then a final contrast guarantee on gold sections. Idempotent and invertible.",
  "steps": [
    {
      "transform": "center_text",
      "selector": {},
      "params": {}
    },
    {
      "transform": "symmetrize_phrase_rows",
      "selector": {},
      "params": {}
    },
    {
      "transform": "set_section_visual",
      "selector": { "section": "hook" },
      "params": { "gradient_direction": "rings_4", "bg_animation_preset": "energetic" }
    },
    {
      "transform": "set_section_visual",
      "selector": { "section": "chorus" },
      "params": { "gradient_direction": "diamond", "bg_animation_preset": "cinematic" }
    },
    {
      "transform": "set_section_visual",
      "selector": { "section": "climax" },
      "params": { "gradient_direction": "burst", "bg_animation_preset": "intense" }
    },
    {
      "transform": "set_section_visual",
      "selector": { "section": "outro" },
      "params": { "gradient_direction": "spot_field", "bg_animation_preset": "minimal" }
    },
    {
      "transform": "shift_section_hue",
      "selector": { "section": "hook" },
      "params": { "delta": 0.06 }
    },
    {
      "transform": "shift_section_hue",
      "selector": { "section": "chorus" },
      "params": { "delta": -0.04 }
    },
    {
      "transform": "vary_line_backgrounds",
      "selector": { "section": "intro" },
      "params": { "mode": "escalate", "hue_span": 0.12, "lit_osc": 0.06, "sat_osc": 0.18 }
    },
    {
      "transform": "vary_line_backgrounds",
      "selector": { "section": "verse" },
      "params": { "mode": "oscillate", "hue_span": 0.10, "lit_osc": 0.05, "sat_osc": 0.12 }
    },
    {
      "transform": "vary_line_backgrounds",
      "selector": { "style": "gold" },
      "params": {
        "mode": "oscillate",
        "hue_span": 0.08,
        "lit_osc": 0.03,
        "sat_osc": 0.08,
        "text_color": "#E6C850",
        "min_contrast": 4.5,
        "lightness_floor": 0.04
      }
    },
    {
      "transform": "set_section_font",
      "selector": { "section": "hook" },
      "params": { "size": 92, "uniform_lines": true }
    },
    {
      "transform": "set_section_font",
      "selector": { "section": "interlude" },
      "params": { "size": 82, "uniform_lines": true }
    },
    {
      "transform": "set_section_font",
      "selector": { "section": "post_hook" },
      "params": { "size": 84, "uniform_lines": true }
    },
    {
      "transform": "set_section_font",
      "selector": { "section": "outro" },
      "params": { "size": 76, "uniform_lines": true }
    },
    {
      "transform": "darken_for_contrast",
      "selector": { "style": "gold" },
      "params": { "text_color": "#E6C850", "min_contrast": 4.5, "lightness_floor": 0.04 }
    }
  ]
}
